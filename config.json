{
  "search": {
    "endpoint": "https://api.github.com/search/repositories",
    "per_page": 30,
    "max_components": 8,
    "max_queries_per_component": 5,
    "max_total_queries": 24,
    "max_query_length": 240,
    "max_rounds": 2,
    "rate_limit_max_wait_seconds": 130
  },
  "defaults": {
    "enforced_min_stars": 100,
    "candidates_per_component": 5,
    "max_candidates_per_component": 10,
    "last_commit_within_days": 730
  },
  "analysis": {
    "workers": 4,
    "readme_excerpt_chars": 4000,
    "readme_match_chars": 30000,
    "top_level_entries_limit": 60,
    "dependency_detail_limit": 50
  },
  "license_policy": {
    "preferred": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC",
                  "0BSD", "Unlicense", "Zlib", "BSL-1.0", "CC0-1.0"],
    "review_required": ["MPL-2.0", "LGPL-2.1", "LGPL-3.0", "GPL-2.0", "GPL-3.0",
                        "EPL-2.0", "EUPL-1.2"],
    "high_risk": ["AGPL-3.0", "SSPL-1.0", "BUSL-1.1", "Elastic-2.0",
                  "CC-BY-NC-4.0", "CC-BY-NC-SA-4.0"],
    "risk_levels": {
      "preferred": "low",
      "review_required": "medium",
      "high_risk": "high",
      "unknown": "high"
    }
  },
  "dependency_manifests": {
    "npm": {
      "files": ["package.json"],
      "lockfiles": ["package-lock.json", "yarn.lock", "pnpm-lock.yaml", "bun.lockb"]
    },
    "python": {
      "files": ["requirements.txt", "pyproject.toml"],
      "lockfiles": ["poetry.lock", "Pipfile.lock", "uv.lock", "pdm.lock"]
    },
    "go": {
      "files": ["go.mod"],
      "lockfiles": ["go.sum"]
    },
    "rust": {
      "files": ["Cargo.toml"],
      "lockfiles": ["Cargo.lock"]
    },
    "java": {
      "files": ["pom.xml", "build.gradle", "build.gradle.kts"],
      "lockfiles": ["gradle.lockfile"]
    }
  },
  "dependency_risk_rules": [
    {"kind": "total", "threshold": 500, "level": "high"},
    {"kind": "total", "threshold": 200, "level": "medium"},
    {"kind": "unpinned", "threshold": 20, "level": "medium"},
    {"kind": "no_lockfile", "level": "medium"}
  ],
  "relevance_weights": {
    "term_coverage": 50,
    "metadata_coverage": 25,
    "tech_stack": 15,
    "query_hits": 10
  },
  "health_weights": {
    "maintenance": 35,
    "code_quality": 25,
    "documentation": 25,
    "reusability": 15
  },
  "rank_weights": {
    "relevance": 70,
    "health": 30
  },
  "documentation_signals": {
    "has_readme": 30,
    "readme_has_install": 20,
    "readme_has_usage": 20,
    "has_docs_folder": 15,
    "has_examples_folder": 15
  },
  "code_quality_signals": {
    "has_tests": 40,
    "has_ci": 35,
    "has_lint_config": 25
  },
  "reusability_signals": {
    "lockfile_present": 25,
    "has_release_or_tags": 25,
    "moderate_dependency_count": 20,
    "has_examples": 15,
    "packaged_project": 15
  },
  "maintenance_buckets": [
    { "max_days": 90, "score": 100 },
    { "max_days": 180, "score": 85 },
    { "max_days": 365, "score": 70 },
    { "max_days": 730, "score": 40 },
    { "score": 10 }
  ],
  "caps": {
    "order": [
      "adopt_as_dependency",
      "fork_and_modify",
      "use_as_template",
      "reference_architecture_only"
    ],
    "license": {
      "preferred": "adopt_as_dependency",
      "review_required": "reference_architecture_only",
      "high_risk": "reference_architecture_only",
      "unknown": "reference_architecture_only"
    },
    "maintenance_below": { "score": 70, "cap": "fork_and_modify" },
    "dependency_risk_high": "fork_and_modify",
    "dependency_parsing_failed": "fork_and_modify"
  },
  "assessment": {
    "max_summary_chars": 500,
    "max_observations": 5,
    "max_evidence_items": 8,
    "max_evidence_chars": 300,
    "max_rationale_chars": 600,
    "max_alternatives": 3
  },
  "output_dir_default": "output/github-prior-art-search"
}
