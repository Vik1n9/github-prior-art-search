{
  "search": {
    "endpoint": "https://api.github.com/search/repositories",
    "per_page": 50,
    "sort": "updated",
    "order": "desc",
    "max_queries": 10,
    "rate_limit_max_wait_seconds": 130
  },
  "defaults": {
    "min_stars": 100,
    "enforced_min_stars": 100,
    "max_candidates": 8,
    "last_commit_within_days": 730
  },
  "license_policy": {
    "preferred": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause"],
    "review_required": ["MPL-2.0", "LGPL-3.0", "GPL-3.0"],
    "high_risk": ["AGPL-3.0", "SSPL-1.0"],
    "unknown": ["NOASSERTION"],
    "scores": {
      "preferred": 100,
      "review_required": 40,
      "high_risk": 10,
      "unknown": 0
    },
    "actions": {
      "preferred": "allow_reuse",
      "review_required": "require_manual_review",
      "high_risk": "avoid_direct_reuse",
      "unknown": "reference_only"
    },
    "risk_levels": {
      "preferred": "low",
      "review_required": "medium",
      "high_risk": "high",
      "unknown": "high"
    }
  },
  "dependency_risk_rules": {
    "high_total_dependencies": {
      "threshold": 200,
      "level": "medium"
    },
    "high_unpinned_dependencies": {
      "threshold": 20,
      "level": "medium"
    },
    "no_lockfile": {
      "level": "medium"
    }
  },
  "scoring_weights": {
    "relevance": 35,
    "reusability": 20,
    "maintenance_activity": 15,
    "code_quality": 10,
    "documentation": 10,
    "license_fit": 10
  },
  "relevance_signals": {
    "name_match": 20,
    "description_match": 15,
    "topics_match": 10,
    "readme_match": 10,
    "feature_match": 30,
    "tech_stack_match": 15,
    "enable_readme_match": true
  },
  "documentation_signals": {
    "has_readme": 30,
    "readme_has_install": 20,
    "readme_has_usage": 20,
    "has_docs_folder": 15,
    "has_examples_folder": 15
  },
  "code_quality_signals": {
    "has_tests": 25,
    "has_ci": 25,
    "has_lint_config": 15,
    "has_release": 15,
    "has_src_structure": 20
  },
  "reusability_signals": {
    "lockfile_present": 5,
    "has_release_or_tags": 4,
    "moderate_dependency_count": 4,
    "has_examples": 4,
    "packaged_project": 3
  },
  "maintenance_buckets": [
    { "max_days": 90, "score": 100 },
    { "max_days": 180, "score": 85 },
    { "max_days": 365, "score": 70 },
    { "max_days": 730, "score": 40 },
    { "score": 10 }
  ],
  "decision_rules": {
    "evaluation_order": [
      "avoid_due_to_risk",
      "adopt_as_dependency",
      "fork_and_modify",
      "use_as_template",
      "reference_architecture_only"
    ],
    "adopt_as_dependency": {
      "total_score": 80,
      "relevance": 80,
      "license_fit": 90,
      "maintenance_activity": 70,
      "dependency_risk_max": "medium"
    },
    "fork_and_modify": {
      "total_score": 75,
      "relevance": 75,
      "license_fit": 70,
      "maintenance_activity": 50
    },
    "use_as_template": {
      "total_score": 70,
      "relevance": 70,
      "license_fit": 70
    },
    "reference_architecture_only": {
      "total_score": 55,
      "relevance": 60
    }
  },
  "output_dir_default": "output/github-prior-art-search",
  "dependency_manifests": {
    "npm": {
      "files": ["package.json"],
      "lockfiles": ["package-lock.json", "yarn.lock", "pnpm-lock.yaml"]
    },
    "python": {
      "files": ["requirements.txt", "pyproject.toml", "setup.py", "poetry.lock", "Pipfile.lock"],
      "lockfiles": ["poetry.lock", "Pipfile.lock"]
    },
    "go": {
      "files": ["go.mod"],
      "lockfiles": ["go.sum"]
    },
    "rust": {
      "files": ["Cargo.toml"],
      "lockfiles": ["Cargo.lock"]
    },
    "java": {
      "files": ["pom.xml", "build.gradle", "build.gradle.kts"],
      "lockfiles": []
    }
  }
}
